# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/fireworks

# Redis Cache Configuration (Disabled by default: set REDIS_ENABLED=true when Redis server is available)
REDIS_ENABLED=false
# Option 1: Full URL connection string (e.g., redis://default:password@localhost:6379 or rediss:// for TLS)
REDIS_URL=
# Option 2: Individual connection parameters
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Razorpay (Optional)
PAYMENTS_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# UPI Settings
UPI_VPA=
UPI_PAYEE_NAME=Elite Eagle Crackers

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_NAME="Elite Eagle Crackers"
FROM_EMAIL=your_email@gmail.com
ADMIN_EMAIL=admin@example.com

# Google OAuth
GOOGLE_CLIENT_ID=

# WhatsApp Business API (Optional)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=order_invoice
